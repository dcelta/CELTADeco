<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Favicon setup -->
    <!--  <link rel="icon" type="image/x-icon" href="favicon.ico"> -->
    <!--  <link rel="icon" type="image/png" sizes="32x32" href="favicon-32x32.png">  -->
    <link rel="icon" type="image/png" href="images/celta-favicon-512px.png">
    <title>CELTADeco — Services &amp; Presentation</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 100%; height: 100%; overflow: hidden; background-color: #525659; }
      iframe { width: 100%; height: 100%; border: none; }
    </style>
  </head>
  <body>
    <iframe id="pdf-frame" src=""></iframe>
    
    <script>
      // Dynamically load the file specified in the URL query string (?file=...)
      const params = new URLSearchParams(window.location.search);
      const pdfFile = params.get('file');
      if (pdfFile) {
	  document.getElementById('pdf-frame').src = pdfFile;
      }
    </script>
  </body>
</html>
