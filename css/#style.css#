/* ==========================================================================
   CELTADECO Core Architecture - CSS Design Tokens & Reset
   ========================================================================== */

:root {
    --bg-primary: #fcfcfc;
    --bg-secondary: #f5f5f3;
    --text-dark: #1a1a1a;
    --text-muted: #666666;
    --accent: #b5a48c;
    --accent-subtle: #a38f68;
    --font-sans: 'Helvetica Neue', Arial, sans-serif;
    --transition-smooth: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    font-family: var(--font-sans);
    scroll-behavior: smooth;
    scroll-padding-top: 220px;
    background-color: var(--bg-primary);
    color: var(--text-dark);
    line-height: 1.6;
}

main {
    padding-top: 130px;
}

/* ==========================================================================
   Utility Classes
   ========================================================================== */

.text-justify { text-align: justify; }
.text-center { text-align: center; }

/* ==========================================================================
   Header & Navigation
   ========================================================================== */

.site-header {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 24px;
    background-color: rgba(26, 26, 26, 0.95); 
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1000;
    transition: transform 0.3s ease-in-out;
}

.site-header.nav-hidden {
    transform: translateY(-100%);
}

.header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
}

.logo-container {
    flex: 1;
    display: flex;
    justify-content: flex-start;
}

.header-logo {
    max-height: 150px;
    width: auto;
    display: block;
}

.hero-title-block {
    flex: 2;
    text-align: center;
    padding: 0 1rem;
}

.hero-title-block h1 {
    font-size: 1.75rem;
    margin: 0 0 4px 0;
    color: #fcfcfc;
    font-weight: 700;
    letter-spacing: -0.01em;
}

.hero-title-block .subtitle {
    font-size: 0.95rem;
    color: #d4c5b0;
    margin: 0 0 2px 0;
}

.hero-title-block .sub-subtitle {
    font-size: 0.8rem;
    color: #888888;
    margin: 0;
}

.main-nav {
    flex: 1;
    display: flex;
    justify-content: flex-end;
}

.main-nav ul {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
}

.main-nav a {
    text-decoration: none;
    color: #fcfcfc;
    text-transform: uppercase;
    white-space: nowrap;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    font-weight: 500;
    line-height: 1;
    transition: var(--transition-smooth);
}

.main-nav a:hover {
    color: #d4c5b0;
}

/* ==========================================================================
   Structural Layouts & Sections
   ========================================================================== */

.section-container {
    padding: 6rem 4% 3rem 4%;
}

.alternative-bg {
    background-color: var(--bg-secondary);
}

.section-header {
    margin-bottom: 4rem;
}

.tracer {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--accent);
    margin-bottom: 0.5rem;
}

.split-layout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 4rem;
    align-items: center;
}

.media-block img {
    width: 100%;
    height: 350px;
    display: block;
    object-fit: cover;
    transition: var(--transition-smooth);
}

/* ==========================================================================
   Project List Accordion Architecture
   ========================================================================== */

.project-accordion-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid #e0e0e0;
}

.project-accordion-item {
    border-bottom: 1px solid #e0e0e0;
}

.project-list-trigger {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 2rem 0;
    cursor: pointer;
    list-style: none;
}

.project-list-trigger::-webkit-details-marker {
    display: none;
}

.trigger-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
}

.project-title {
    font-size: 1.5rem;
    font-weight: 300;
    letter-spacing: -0.01em;
}

.project-loc {
    font-size: 0.85rem;
    color: var(--text-muted);
}

.accordion-arrow {
    font-size: 1.5rem;
    color: var(--accent);
    transition: transform 0.3s ease;
}

.project-accordion-item[open] .accordion-arrow {
    transform: rotate(45deg);
}

.project-drawer-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    padding: 2rem 0 4rem 0;
    animation: fadeIn 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.accordion-figure {
    position: relative; 
    max-height: 80vh;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.drawer-thumbnail-container {
    max-height: 80vh;
    overflow-y: auto;
    padding-right: 8px;
}

.drawer-thumbnail-container h4 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
}

.drawer-content-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
    gap: 1rem;
    padding: 1rem 0;
}

.drawer-thumbnail {
    width: 100%;
    height: 80px;
    object-fit: cover;
    border-radius: 2px;
    cursor: pointer;
    transition: var(--transition-smooth);
}

.drawer-thumbnail:hover {
    opacity: 0.8;
}

.rotating-thumb {
    width: 280px;
    height: 240px;
    object-fit: cover;
    display: block;
    border-radius: 4px;
}

.img-scroll-container {
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: relative;
    cursor: zoom-in;
    border: 1px solid #e0e0e0;
    background-color: #f9f9f9;
}

.main-showcase-img {
    max-height: 80vh;
    width: auto;
    object-fit: contain;
    display: block;
    transform-origin: center center;
    transition: transform 0.15s cubic-bezier(0.25, 0.8, 0.25, 1);
}

/* ==========================================================================
   Approach Table Refined Architecture
   ========================================================================== */

.table-responsive {
    width: 100%;
    overflow-x: auto;
    margin-top: 2.5rem;
    border-radius: 6px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.06);
}

.approach-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.925rem;
    line-height: 1.65;
}

.approach-table thead tr {
    border-bottom: 2px solid var(--text-dark);
    background-color: #fafafa;
}

.approach-table th {
    padding: 1.2rem 1.5rem;
    text-transform: uppercase;
    font-size: 0.725rem;
    letter-spacing: 0.12em;
    font-weight: 700;
    color: var(--text-dark);
}

.approach-table tbody tr {
    transition: background-color 0.25s ease;
}

.approach-table tbody tr:hover {
    background-color: rgba(181, 164, 140, 0.05);
}

.approach-table td {
    padding: 1.75rem 1.5rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    vertical-align: top;
    color: var(--text-dark);
}

.approach-table tbody tr:last-child td {
    border-bottom: none;
}

.col-phase { width: 10%; }
.col-title { width: 28%; }
.col-details { width: 62%; }

.phase-badge {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--accent);
    background-color: rgba(181, 164, 140, 0.12);
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    border: 1px solid rgba(181, 164, 140, 0.25);
}

.phase-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-dark);
    letter-spacing: -0.01em;
}

/* Pill Tags for Deliverables */
.pill-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.85rem;
}

.spec-pill {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-dark);
    background-color: var(--bg-secondary);
    border: 1px solid rgba(0, 0, 0, 0.08);
    padding: 0.2rem 0.65rem;
    border-radius: 12px;
    letter-spacing: 0.02em;
}

/* ==========================================================================
   About / Bio Section
   ========================================================================== */

.bio-headline {
    font-size: 2rem;
    font-weight: 300;
    line-height: 1.3;
    margin: 0.5rem 0 1.5rem 0;
    color: var(--text-dark);
}

.bio-intro {
    font-size: 1.1rem;
}

.bio-social-links {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
}

.btn-social {
    display: inline-block;
    padding: 0.6rem 1.4rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: #ffffff;
    background-color: #1a1a1a;
    border: 1px solid #1a1a1a;
    text-decoration: none;
    transition: var(--transition-smooth);
}

.btn-social:hover {
    background-color: var(--accent);
    border-color: var(--accent);
    color: #ffffff;
}

.bio-portrait {
    width: 100%;
    max-width: 320px;
    height: auto;
    display: block;
    margin: 0 auto;
    border-radius: 2px;
}

/* ==========================================================================
   Contact Section Styles 
   ========================================================================== */

.contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2.5rem;
    margin-top: 2rem;
}

.contact-card {
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    padding: 2rem;
    transition: border-color 0.3s ease;
}

.contact-card:hover {
    border-color: var(--accent);
}

.contact-card-heading {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    color: var(--text-dark);
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
}

.contact-list li {
    display: flex;
    flex-direction: column;
    margin-bottom: 1.25rem;
}

.contact-list li:last-child {
    margin-bottom: 0;
}

.contact-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #888;
    margin-bottom: 0.25rem;
}

.contact-link,
.contact-text {
    font-size: 1rem;
    color: var(--text-dark);
    text-decoration: none;
    transition: color 0.2s ease;
}

.contact-link:hover {
    color: var(--accent);
}

/* ==========================================================================
   Footer
   ========================================================================== */

.site-footer {
    padding: 2rem 4%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: 0.8rem;
    color: #777777;
    background-color: rgba(26, 26, 26, 0.95);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
}

.footer-container {
    margin: 0 auto;
}

.footer-logo {
    height: 200px;
    width: auto;
    display: block;
    margin: 0 auto;
    object-fit: contain;
    filter: invert(1) brightness(2);
}

.site-footer .footer-info {
    margin-top: 1rem;
}

.site-footer p {
    font-size: 0.75rem;
    color: #777777;
    line-height: 1.4;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(-5px); }
    to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 768px) {
    .header-container {
        flex-direction: column;
        gap: 1rem;
    }
    .logo-container, .main-nav {
        justify-content: center;
    }
    .project-drawer-wrapper {
        grid-template-columns: 1fr;
        gap: 2rem;
    }
    .approach-table th, 
    .approach-table td {
        padding: 1rem 0.75rem;
    }
    .col-phase { width: 12%; }
    .col-title { width: 33%; }
    .col-details { width: 55%; }
}

/* ---
   ==========================================================================
   PDF Download Callout Section
   ==========================================================================
   --- */

.pdf-download-card {
  margin-top: 3rem;
  padding: 2rem 2.5rem;
  background-color: var(--bg-secondary, #f5f5f3);
  border: 1px solid rgba(0, 0, 0, 0.08);
  border-left: 4px solid var(--text-dark, #1a1a1a);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
}

.pdf-download-content {
  max-width: 600px;
}

.pdf-badge {
  display: inline-block;
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--text-muted, #666666);
  margin-bottom: 0.4rem;
  font-weight: 600;
}

.pdf-download-content h3 {
  font-size: 1.25rem;
  margin-bottom: 0.3rem;
  color: var(--text-dark, #1a1a1a);
}

.pdf-download-content p {
  font-size: 0.9rem;
  color: var(--text-muted, #666666);
  margin: 0;
  line-height: 1.4;
}

/* Button Styling */
.btn-pdf {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.85rem 1.6rem;
  background-color: var(--text-dark, #1a1a1a);
  color: #ffffff;
  text-decoration: none;
  font-size: 0.85rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  border-radius: 2px;
  transition: background-color 0.25s ease, transform 0.2s ease;
  white-space: nowrap;
}

.btn-pdf:hover {
  background-color: var(--accent, #b5a48c);
  color: #ffffff;
  transform: translateY(-2px);
}

.btn-pdf svg {
  transition: transform 0.2s ease;
}

.btn-pdf:hover svg {
  transform: translateY(2px);
}

/* Responsive adjustment for mobile screens */
@media (max-width: 768px) {
  .pdf-download-card {
    flex-direction: column;
    align-items: flex-start;
    padding: 1.5rem;
    gap: 1.5rem;
  }
  
  .pdf-download-action {
    width: 100%;
  }

  .btn-pdf {
    width: 100%;
    justify-content: center;
  }
}

/* Dual Button Layout */
.pdf-download-action {
  display: flex;
  gap: 0.75rem;
  align-items: center;
  flex-wrap: wrap;
}

/* Secondary Button Variant (Outlined style for language distinction) */
.btn-pdf-secondary {
  background-color: transparent;
  color: var(--text-dark, #1a1a1a);
  border: 1px solid var(--text-dark, #1a1a1a);
}

.btn-pdf-secondary:hover {
  background-color: var(--text-dark, #1a1a1a);
  color: #ffffff;
  border-color: var(--text-dark, #1a1a1a);
}

/* Responsive adjustment for mobile screens */
@media (max-width: 768px) {
  .pdf-download-action {
    width: 100%;
    flex-direction: column;
  }

  .pdf-download-action .btn-pdf {
    width: 100%;
    justify-content: center;
  }
}
